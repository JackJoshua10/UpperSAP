# Supabase (Project Settings -> API). Son claves publicas: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Gemini (gratis en https://aistudio.google.com/apikey). Solo servidor, nunca NEXT_PUBLIC_.
# Si se deja vacia, la app usa una plantilla en lugar de IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
